# Banco de dados (PostgreSQL)
# ATENÇÃO: nomes devem bater com o que backend/app.py espera via os.getenv
POSTGRES_USER=painel_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=servidores_federais
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend (Flask)
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=troque_esta_chave

# Frontend (build-time — só tem efeito se o Dockerfile do frontend
# tiver ARG VITE_API_URL + ENV VITE_API_URL=$VITE_API_URL antes do
# `npm run build`. Ver observação no docker-compose.yml.)
VITE_API_URL=http://localhost:5000